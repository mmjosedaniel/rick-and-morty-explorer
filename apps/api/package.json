{
  "name": "@rick-and-morty/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "start:smoke": "npm run build && npm run start",
    "test:unit": "vitest run --config ../../vitest.config.ts --project api-unit",
    "test:application": "vitest run --config ../../vitest.config.ts --project api-application"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
}
