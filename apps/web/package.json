{
  "name": "@rick-and-morty/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc --project tsconfig.server.json",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "node dist-server/server.js",
    "start:smoke": "npm run build && npm run start",
    "test:unit": "vitest run --config ../../vitest.config.ts --project web-unit",
    "test:application": "vitest run --config ../../vitest.config.ts --project web-application"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5"
  }
}
